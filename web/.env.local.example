# Copy this file to .env.local and fill in values from your Supabase project.
# Supabase Dashboard → Connect, or Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# New Supabase docs call this "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Old name still works too (optional):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

# Optional: only for local admin scripts — NEVER put this in frontend code or commit it
# SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here

# Admin console (/admin): comma-separated emails allowed to access (REQUIRED)
# Without this, nobody can open /admin
# ADMIN_EMAILS=you@example.com

# ===== Redis cache (optional, Upstash) =====
# https://console.upstash.com → Create Redis → REST API
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
# Without these, the app still works (cache is skipped).

# ===== AI（配置了就会按优先级尝试）=====
# 0) P0–P2 Agent（ReAct + Plan Mode + 安全门 + 记忆/压缩）
# AGENT_ENABLED=true
# AGENT_MAX_STEPS=8
# AGENT_DEFAULT_MODE=react
# AGENT_PERMISSION_MODE=confirm
#   confirm: 复杂问题先出 Plan，Approve 后才跑工具；Decline 零工具
#   auto: 跳过 Plan UI，直接 ReAct（仍拦写工具与医疗违规）
#   read_only: 禁止未来写类工具
# AGENT_MEMORY_ENABLED=true
# AGENT_CONTEXT_TOKEN_LIMIT=120000
# AGENT_COMPRESS_TRIGGER_RATIO=0.75
# AGENT_SKILLS_ENABLED=true
# AGENT_MCP_LAZY_LOAD=true
# AGENT_MULTI_AGENT_ENABLED=true
# 另需在 Supabase 运行 supabase/migrations/005_agent_memories.sql
# MCP 配置示例: mcp.json.example；Skill 文档: skills/*/
# 需要支持 tools 的模型：Gemini（默认优先）/ OpenAI / Groq / 豆包 / Ollama(需支持 tools)
# 失败时自动回退经典 Light RAG

# 1) 本地微调模型 via Ollama
# 先: ollama create sihatq-qwen2.5-7b-ft -f Modelfile && ollama serve
# OLLAMA_MODEL=sihatq-qwen2.5-7b-ft
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# 2) 豆包 / 火山方舟
# 控制台: https://console.volcengine.com/ark
# DOUBAO_API_KEY=你的方舟API_Key
# DOUBAO_MODEL=ep-xxxxxxxx  （推理接入点 ID，或模型名）

# 3) Google Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# 4) Groq: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# 5) OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
